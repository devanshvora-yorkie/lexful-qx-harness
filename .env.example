# Copy to .env. Never commit .env.

# App under test
QA_ENV_URL=https://e2e-test.uat.lexful.net
STYTCH_API_URL=https://api.uat.lexful.net

# Stytch. The organization id and the tenant slug are separate.
# STYTCH_PERSONA picks which account signs in: admin, support, or viewer.
# One session file is written: runs/cache/stytch/session.json
STYTCH_PERSONA=admin
SLUG=e2e-test
STYTCH_ORGANIZATION_ID=

STYTCH_ADMIN_EMAIL=
STYTCH_ADMIN_PASSWORD=

STYTCH_SUPPORT_EMAIL=
STYTCH_SUPPORT_PASSWORD=

STYTCH_VIEWER_EMAIL=
STYTCH_VIEWER_PASSWORD=

# Linear. Reads: LEX team. Creates: York team / Test-QA-Bot-York-IE only (not Lexful's backlog).
# This server calls Linear with LINEAR_API_KEY. The team and project ids match the harness file.
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_API_KEY=
LINEAR_READ_TEAM_ID=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
LINEAR_WRITE_TEAM_ID=
LINEAR_WRITE_PROJECT_ID=

# GitHub. Pull-request files only.
GITHUB_ORG=Lexful-ai
GITHUB_REPO=docu-stack
GITHUB_TOKEN=

# Open locally. On EC2 set LOCAL_MODE=false and HARNESS_DEPLOY_SECRET.
LOCAL_MODE=true
HARNESS_DEPLOY_SECRET=
QA_SERVER_PORT=8787

# Every step uses Claude Haiku 5.5 on Amazon Bedrock in us-east-1.
# The agent ids are also set in opencode.jsonc.
OPENCODE_MAIN_MODEL=amazon-bedrock/us.anthropic.claude-haiku-5-5
OPENCODE_SUB_MODEL=amazon-bedrock/us.anthropic.claude-haiku-5-5
QA_HEAL_ATTEMPTS=3
QA_AGENT_TIMEOUT_SECONDS=2700

# E2E User Journey TCs on container start. Set false to skip them. npm run e2e still starts one.
QA_PHASE1_ON_START=true

# Amazon Bedrock API key (bearer). The container maps this to AWS_BEARER_TOKEN_BEDROCK.
# Model id sent to Bedrock: us.anthropic.claude-haiku-5-5
AWS_REGION=us-east-1
BEDROCK_API_KEY=

# UI/UX audit. Separate from both suites. false runs Feature Specific functional QA only.
# QA_RUN_UX_AUDIT: run UI/UX audit after functional QA on a ticket (default: true)
# QA_UX_BEFORE_AFTER: generate Before/After concept mocks & screenshots for visual_fix checks (default: false)
# QA_UX_MODE: "simple" (solution focus) or "advanced" (full context, reasoning, and breakdown)
QA_RUN_UX_AUDIT=true
QA_UX_BEFORE_AFTER=false
QA_UX_MODE=simple
