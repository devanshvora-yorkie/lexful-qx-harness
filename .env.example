# Copy to .env. Never commit .env.

# App under test
QA_ENV_URL=https://e2e-test.uat.lexful.net
STYTCH_API_URL=https://api.uat.lexful.net

# Stytch. The organization id and the tenant slug are separate.
# STYTCH_PERSONA is the default sign-in: admin, support, or viewer.
# A run starts as that persona. Switch on demand with:
#   node scripts/persona.mjs support
#   node scripts/persona.mjs viewer
# The default cookies stay in runs/cache/stytch/session.json.
# A switched persona is stored beside it as runs/cache/stytch/<persona>.json.
STYTCH_PERSONA=admin
SLUG=e2e-test
STYTCH_ORGANIZATION_ID=

STYTCH_ADMIN_EMAIL=
STYTCH_ADMIN_PASSWORD=

STYTCH_SUPPORT_EMAIL=
STYTCH_SUPPORT_PASSWORD=

STYTCH_VIEWER_EMAIL=
STYTCH_VIEWER_PASSWORD=

# Linear. Reads: LEX team. Creates: York team / Test-QA-Bot-York-IE only (not Lexful's backlog).
# This server calls Linear with LINEAR_API_KEY. The team and project ids match the harness file.
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_API_KEY=
LINEAR_READ_TEAM_ID=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
LINEAR_WRITE_TEAM_ID=
LINEAR_WRITE_PROJECT_ID=

# GitHub. Pull-request files only.
GITHUB_ORG=Lexful-ai
GITHUB_REPO=docu-stack
GITHUB_TOKEN=

# Open locally. On EC2 set LOCAL_MODE=false and HARNESS_DEPLOY_SECRET.
LOCAL_MODE=true
HARNESS_DEPLOY_SECRET=
QA_SERVER_PORT=8787

# Model ids. The server passes these to OpenCode. Prompts do not name a model.
# OPENCODE_MAIN_MODEL is the coordinator. OPENCODE_SUB_MODEL is Explore, Author, Heal, and the UX audit.
# The same ids are set on the agents in opencode.jsonc. Preflight checks they match.
OPENCODE_MAIN_MODEL=amazon-bedrock/us.anthropic.claude-haiku-5-5
OPENCODE_SUB_MODEL=amazon-bedrock/us.anthropic.claude-haiku-5-5
QA_HEAL_ATTEMPTS=3
QA_AGENT_TIMEOUT_SECONDS=2700
# One Playwright invocation. A heal starts another. The default is 2700.
QA_PLAYWRIGHT_TIMEOUT_SECONDS=2700

# Where run folders are written. The default is ./runs next to this file.
# QA_RUNS_DIR=

# Run E2E User Journey TCs before each Feature Specific ticket (npm run ticket). false skips E2E for tickets.
# Container start never runs E2E. Use npm run e2e to run the checked-in suite on demand.
QA_PHASE1_ON_START=true

# Amazon Bedrock API key (bearer). The container maps this to AWS_BEARER_TOKEN_BEDROCK.
# The model id above is a US inference profile, so this region stays us-east-1.
# opencode.jsonc sets the same region on the provider.
AWS_REGION=us-east-1
BEDROCK_API_KEY=

# UI/UX audit. Separate from both suites. false runs Feature Specific functional QA only.
QA_RUN_UX_AUDIT=true
