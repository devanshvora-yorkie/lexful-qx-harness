# Copy to .env and fill it in. Never commit .env. ./build.sh creates it from this file.

# ── Required ────────────────────────────────────────────────────────────────────────────────
# ./build.sh refuses to start until these have values.
STYTCH_ORGANIZATION_ID=
STYTCH_ADMIN_EMAIL=
STYTCH_ADMIN_PASSWORD=
LINEAR_API_KEY=
GITHUB_TOKEN=
# Amazon Bedrock API key. The container passes it to OpenCode as AWS_BEARER_TOKEN_BEDROCK.
BEDROCK_API_KEY=

# ── Test accounts (optional) ────────────────────────────────────────────────────────────────
# A case that runs as another role signs in with: node scripts/persona.mjs support
STYTCH_SUPPORT_EMAIL=
STYTCH_SUPPORT_PASSWORD=
STYTCH_VIEWER_EMAIL=
STYTCH_VIEWER_PASSWORD=
# The account a run starts as: admin, support or viewer.
STYTCH_PERSONA=admin

# ── Target ──────────────────────────────────────────────────────────────────────────────────
QA_ENV_URL=https://e2e-test.uat.lexful.net
STYTCH_API_URL=https://api.uat.lexful.net
SLUG=e2e-test

# ── Sources ─────────────────────────────────────────────────────────────────────────────────
# Linear is read for the ticket. It is written only when QA_LINEAR_LOG=true, and only to the write team and project.
LINEAR_API_URL=https://api.linear.app/graphql
# Where tickets are created. Must not be the team the ticket is read from.
LINEAR_WRITE_TEAM_ID=
LINEAR_WRITE_PROJECT_ID=
# true: each finished run gets a tracking ticket, a comment and a Bug ticket per bug. See docs/linear-logging.md.
QA_LINEAR_LOG=false
# Where run folders are served, if you host them (no trailing slash). Empty uploads ux-report.html to Linear.
QA_REPORT_BASE_URL=
# Pull requests and deployments are read from this repo.
GITHUB_ORG=Lexful-ai
GITHUB_REPO=docu-stack

# ── Models and region ───────────────────────────────────────────────────────────────────────
# One model runs every session of the one qa agent: Explore, Author, Heal, the verifier, Promote and the UX audit.
# opencode.jsonc names the same id in its top-level "model"; preflight checks that they match.
OPENCODE_MAIN_MODEL=amazon-bedrock/us.anthropic.claude-haiku-5-5
# The model ids above are US inference profiles, so keep this region.
AWS_REGION=us-east-1

# ── Ticket context ──────────────────────────────────────────────────────────────────────────
# Preflight saves the full ticket and pull request text under the run's context/. These limit what is added to it.
# Images downloaded from the ticket and its pull requests. An image costs tokens only when the agent opens it.
QA_CONTEXT_MAX_IMAGES=12
# Tickets and pull requests the agent may fetch per run with scripts/lookup.mjs. Only ones the context names.
QA_LOOKUP_MAX_TICKETS=8
QA_LOOKUP_MAX_PRS=5

# ── What a run does ─────────────────────────────────────────────────────────────────────────
# true: every ticket run starts with the E2E User Journey stage (its own e2e/ folder).
# false: ticket only. npm run e2e still runs the checked-in suite on its own.
QA_PHASE1_ON_START=true
# false runs Feature Specific functional QA only.
QA_RUN_UX_AUDIT=true
# The UX audit runs beside Playwright and heal. Its lines are marked ux-audit in run.log.
QA_UX_PARALLEL=true
# A fresh session reproduces each suspected bug before it is filed.
QA_VERIFY_FINDINGS=true
# Heal rounds per run. Each round starts from the run files.
QA_HEAL_ATTEMPTS=3
# false resumes the Explore session in heal instead of a fresh one.
QA_HEAL_FRESH_SESSION=true
# Run a merged pull request even when UAT does not show it deployed yet.
QA_ALLOW_UNDEPLOYED=false
# Time limits in seconds. One Playwright invocation; a heal starts another.
QA_AGENT_TIMEOUT_SECONDS=2700
QA_PLAYWRIGHT_TIMEOUT_SECONDS=2700

# ── Speed and safety ────────────────────────────────────────────────────────────────────────
# Browsers that hit UAT at the same time. More workers means more CloudFront 403 blocks.
QA_PW_WORKERS=3
# true: each test goes to the next free worker. false: one spec file per worker.
QA_PW_FULLY_PARALLEL=true
# Runs executed at the same time. One is the safe setting.
QA_MAX_PARALLEL_RUNS=1
# Resumes of an agent session after a dropped connection.
QA_AGENT_RETRIES=1
# OpenCode and Playwright run as this user, so they cannot read the server's secrets. Empty runs as root.
QA_AGENT_USER=qa
# Minutes between checks of the saved Stytch sessions during a run. 0 turns the check off.
QA_SESSION_CHECK_MINUTES=20

# ── Server ──────────────────────────────────────────────────────────────────────────────────
# With no HARNESS_DEPLOY_SECRET and LOCAL_MODE=true the API takes any caller on 127.0.0.1 (the only
# address it is published on). When HARNESS_DEPLOY_SECRET is set, every call needs it, in either mode.
# LOCAL_MODE=false with no secret refuses all calls. See docs/security.md.
LOCAL_MODE=true
HARNESS_DEPLOY_SECRET=
# The API is published on 127.0.0.1 only.
QA_SERVER_PORT=8787
# Where run folders are written. The default is ./runs next to this file.
# QA_RUNS_DIR=
