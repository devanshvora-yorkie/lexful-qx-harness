{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5",
  "small_model": "amazon-bedrock/us.anthropic.claude-haiku-5-5",
  "provider": {
    "amazon-bedrock": {
      "options": {
        // US inference profile. Keep this the same value as AWS_REGION in .env.
        "region": "us-east-1"
      },
      "models": {
        "us.anthropic.claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "id": "us.anthropic.claude-haiku-5-5"
        }
      }
    }
  },
  "default_agent": "qa",
  "instructions": [
    ".agents/skills/lexful-autonomous-agent-qa/references/custom-instructions.md"
  ],
  // OpenCode 2. Last matching rule wins.
  // The working directory is /opt/lexful-qa-opencode inside the container.
  // external_directory deny blocks every other path, on any host.
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": ".env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "runs/cache/**", "effect": "deny" },
    { "action": "read", "resource": "**/session.json", "effect": "deny" },
    { "action": "edit", "resource": ".env", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": ".env.*", "effect": "deny" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env.*", "effect": "deny" },
    { "action": "edit", "resource": ".env.example", "effect": "deny" },
    { "action": "edit", "resource": "auth-state.json", "effect": "deny" },
    { "action": "edit", "resource": "**/auth-state.json", "effect": "deny" },
    { "action": "edit", "resource": "runs/cache/**", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "bash", "resource": "git clone *", "effect": "deny" },
    { "action": "bash", "resource": "*api.github.com/repos/Lexful-ai/docu-stack/contents*", "effect": "deny" },
    { "action": "bash", "resource": "*api.github.com/repos/Lexful-ai/docu-stack/git/*", "effect": "deny" },
    { "action": "bash", "resource": "*github.com/Lexful-ai/docu-stack*", "effect": "deny" },
    { "action": "shell", "resource": "git clone *", "effect": "deny" },
    { "action": "shell", "resource": "*api.github.com/repos/Lexful-ai/docu-stack/contents*", "effect": "deny" },
    { "action": "shell", "resource": "*api.github.com/repos/Lexful-ai/docu-stack/git/*", "effect": "deny" },
    { "action": "shell", "resource": "*github.com/Lexful-ai/docu-stack*", "effect": "deny" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": "auth-state.json", "effect": "deny" },
    { "action": "read", "resource": "**/auth-state.json", "effect": "deny" },
    { "action": "bash", "resource": "*cat*.env*", "effect": "deny" },
    { "action": "bash", "resource": "*head*.env*", "effect": "deny" },
    { "action": "bash", "resource": "*tail*.env*", "effect": "deny" },
    { "action": "bash", "resource": "*less*.env*", "effect": "deny" },
    { "action": "bash", "resource": "*sed*.env*", "effect": "deny" },
    { "action": "bash", "resource": "*awk*.env*", "effect": "deny" },
    { "action": "bash", "resource": "*printenv*", "effect": "deny" },
    { "action": "bash", "resource": "env", "effect": "deny" },
    { "action": "bash", "resource": "env *", "effect": "deny" },
    { "action": "bash", "resource": "*process.env*", "effect": "deny" },
    { "action": "bash", "resource": "*cat*auth-state.json*", "effect": "deny" },
    { "action": "bash", "resource": "*head*auth-state.json*", "effect": "deny" },
    { "action": "bash", "resource": "*tail*auth-state.json*", "effect": "deny" },
    { "action": "bash", "resource": "*cat*session.json*", "effect": "deny" },
    { "action": "bash", "resource": "*head*session.json*", "effect": "deny" },
    { "action": "bash", "resource": "*tail*session.json*", "effect": "deny" },
    { "action": "shell", "resource": "*cat*session.json*", "effect": "deny" },
    { "action": "shell", "resource": "*head*session.json*", "effect": "deny" },
    { "action": "shell", "resource": "*tail*session.json*", "effect": "deny" },
    { "action": "bash", "resource": "*opencode/auth.json*", "effect": "deny" },
    { "action": "shell", "resource": "*cat*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*printenv*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "*process.env*", "effect": "deny" },
    { "action": "shell", "resource": "*cat*auth-state.json*", "effect": "deny" },
    { "action": "shell", "resource": "*opencode/auth.json*", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    },
    "qa": {
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5",
      "description": "Coordinates one LEX ticket and delegates exploration, authoring, and healing",
      "system": "Read .agents/prompts/qa.md and .agents/skills/lexful-autonomous-agent-qa/SKILL.md. You coordinate Feature Specific TCs. Delegate Explore to qa-explorer, Author to qa-author, and Heal to qa-healer. If the server says E2E User Journey TCs, delegate only to qa-healer. Stay inside this repository. Do not read .env. Do not clone a product repo.",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": ".env", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": ".env.*", "effect": "deny" },
        { "action": "read", "resource": "**/.env", "effect": "deny" },
        { "action": "read", "resource": "**/.env.*", "effect": "deny" },
        { "action": "read", "resource": "runs/cache/**", "effect": "deny" },
        { "action": "read", "resource": ".env.example", "effect": "allow" },
        { "action": "read", "resource": "**/.env.example", "effect": "allow" },
        { "action": "read", "resource": "auth-state.json", "effect": "deny" },
        { "action": "read", "resource": "**/auth-state.json", "effect": "deny" },
        { "action": "bash", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "bash", "resource": "*printenv*", "effect": "deny" },
        { "action": "bash", "resource": "env", "effect": "deny" },
        { "action": "bash", "resource": "*process.env*", "effect": "deny" },
        { "action": "bash", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "bash", "resource": "*opencode/auth.json*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "shell", "resource": "*printenv*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "shell", "resource": "*opencode/auth.json*", "effect": "deny" }
      ]
    },
    "qa-explorer": {
      "mode": "subagent",
      "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5",
      "description": "Explore the live UAT app with playwright-cli and write FEATURE.md. No specs, no login, no Linear or GitHub.",
      "system": "Read .agents/prompts/qa-explorer.md and the Explore step of .agents/skills/lexful-autonomous-agent-qa/SKILL.md. Use playwright-cli only. Do not write specs. Load runs/cache/stytch/session.json with playwright-cli state-load. Do not read that file or .env.",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": ".env", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": ".env.*", "effect": "deny" },
        { "action": "read", "resource": "**/.env", "effect": "deny" },
        { "action": "read", "resource": "**/.env.*", "effect": "deny" },
        { "action": "read", "resource": "runs/cache/**", "effect": "deny" },
        { "action": "read", "resource": ".env.example", "effect": "allow" },
        { "action": "read", "resource": "**/.env.example", "effect": "allow" },
        { "action": "read", "resource": "auth-state.json", "effect": "deny" },
        { "action": "read", "resource": "**/auth-state.json", "effect": "deny" },
        { "action": "bash", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "bash", "resource": "*printenv*", "effect": "deny" },
        { "action": "bash", "resource": "env", "effect": "deny" },
        { "action": "bash", "resource": "*process.env*", "effect": "deny" },
        { "action": "bash", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "bash", "resource": "*opencode/auth.json*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "shell", "resource": "*printenv*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "shell", "resource": "*opencode/auth.json*", "effect": "deny" }
      ]
    },
    "qa-author": {
      "mode": "subagent",
      "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5",
      "description": "Write POM and Playwright specs from FEATURE.md and the context pack. No browser exploration.",
      "system": "Read .agents/prompts/qa-author.md and the Author step of .agents/skills/lexful-autonomous-agent-qa/SKILL.md. Read e2e-coverage.md and do not rewrite a case it lists. Write specs from FEATURE.md and the context pack. Do not explore. Do not read .env. Do not clone a product repo.",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": ".env", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": ".env.*", "effect": "deny" },
        { "action": "read", "resource": "**/.env", "effect": "deny" },
        { "action": "read", "resource": "**/.env.*", "effect": "deny" },
        { "action": "read", "resource": "runs/cache/**", "effect": "deny" },
        { "action": "read", "resource": ".env.example", "effect": "allow" },
        { "action": "read", "resource": "**/.env.example", "effect": "allow" },
        { "action": "read", "resource": "auth-state.json", "effect": "deny" },
        { "action": "read", "resource": "**/auth-state.json", "effect": "deny" },
        { "action": "bash", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "bash", "resource": "*printenv*", "effect": "deny" },
        { "action": "bash", "resource": "env", "effect": "deny" },
        { "action": "bash", "resource": "*process.env*", "effect": "deny" },
        { "action": "bash", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "bash", "resource": "*opencode/auth.json*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "shell", "resource": "*printenv*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "shell", "resource": "*opencode/auth.json*", "effect": "deny" }
      ]
    },
    "qa-healer": {
      "mode": "subagent",
      "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5",
      "description": "Heal spec drift in the checked-in suite. Report a product bug. Do not add tests or call Linear.",
      "system": "Read .agents/prompts/qa-healer.md and the Heal step in .agents/skills/lexful-autonomous-agent-qa/SKILL.md. Patch renamed locators, strict-mode locators, and an existing wait that expired while the control was already visible. Write triage.json with a bugs array for product defects. Do not file a skipped or deprecated test. Do not add a test. Do not edit a spec to hide a product bug. Do not read .env.",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": ".env", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": ".env.*", "effect": "deny" },
        { "action": "read", "resource": "**/.env", "effect": "deny" },
        { "action": "read", "resource": "**/.env.*", "effect": "deny" },
        { "action": "read", "resource": "runs/cache/**", "effect": "deny" },
        { "action": "read", "resource": ".env.example", "effect": "allow" },
        { "action": "read", "resource": "**/.env.example", "effect": "allow" },
        { "action": "read", "resource": "auth-state.json", "effect": "deny" },
        { "action": "read", "resource": "**/auth-state.json", "effect": "deny" },
        { "action": "bash", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "bash", "resource": "*printenv*", "effect": "deny" },
        { "action": "bash", "resource": "env", "effect": "deny" },
        { "action": "bash", "resource": "*process.env*", "effect": "deny" },
        { "action": "bash", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "bash", "resource": "*opencode/auth.json*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "shell", "resource": "*printenv*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "shell", "resource": "*opencode/auth.json*", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "edit", "resource": "scripts/**", "effect": "deny" },
        { "action": "edit", "resource": ".agents/**", "effect": "deny" },
        { "action": "edit", "resource": "playwright.config.ts", "effect": "deny" },
        { "action": "edit", "resource": "auth-helper.ts", "effect": "deny" },
        { "action": "edit", "resource": "e2e test cases/**", "effect": "allow" },
        { "action": "edit", "resource": "e2e test cases/changes.log", "effect": "deny" },
        { "action": "edit", "resource": "runs/**", "effect": "allow" },
        { "action": "edit", "resource": "**/FEATURE.md", "effect": "deny" }
      ]
    },
    "ux-auditor": {
      "mode": "subagent",
      "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5",
      "description": "Audits the ticket journey for UX quality and writes structured findings. The server renders the HTML report.",
      "system": "Read .agents/prompts/ux-auditor.md, .agents/skills/ux-audit/SKILL.md, .agents/skills/design-system/SKILL.md, and .agents/ux/traceability.md. Use playwright-cli state-load runs/cache/stytch/session.json. Evaluate the ticket journey against .agents/ux/checks.yaml and .agents/ux/pattern-library.md. Write ux-findings.json and ux-scorecard.json in the run directory. The harness fills .agents/skills/lexful-ux-audit-gate/audit-preview.html into ux-report.html. Do not write HTML or fill that template.",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": ".env", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": ".env.*", "effect": "deny" },
        { "action": "read", "resource": "**/.env", "effect": "deny" },
        { "action": "read", "resource": "**/.env.*", "effect": "deny" },
        { "action": "read", "resource": "runs/cache/**", "effect": "deny" },
        { "action": "read", "resource": ".env.example", "effect": "allow" },
        { "action": "read", "resource": "**/.env.example", "effect": "allow" },
        { "action": "read", "resource": "auth-state.json", "effect": "deny" },
        { "action": "read", "resource": "**/auth-state.json", "effect": "deny" },
        { "action": "read", "resource": ".agents/**", "effect": "allow" },
        { "action": "bash", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "bash", "resource": "*printenv*", "effect": "deny" },
        { "action": "bash", "resource": "env", "effect": "deny" },
        { "action": "bash", "resource": "*process.env*", "effect": "deny" },
        { "action": "bash", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "bash", "resource": "*opencode/auth.json*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*.env*", "effect": "deny" },
        { "action": "shell", "resource": "*printenv*", "effect": "deny" },
        { "action": "shell", "resource": "*cat*auth-state.json*", "effect": "deny" },
        { "action": "shell", "resource": "*opencode/auth.json*", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "edit", "resource": "scripts/**", "effect": "deny" },
        { "action": "edit", "resource": ".agents/**", "effect": "deny" },
        { "action": "edit", "resource": "playwright.config.ts", "effect": "deny" },
        { "action": "edit", "resource": "auth-helper.ts", "effect": "deny" },
        { "action": "edit", "resource": "e2e test cases/**", "effect": "deny" },
        { "action": "edit", "resource": "runs/**", "effect": "allow" }
      ]
    }
  }
}
